        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Canonical Scenario Generation&lt;/font&gt;&lt;br&gt;&lt;br&gt;Stratified ZIP sampling&lt;br&gt;Gold-catalog drug pools&lt;br&gt;Local PDE-compatible templates&lt;br&gt;Benchmark + stress cases&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Six bundles and source-mix manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=14;fontColor=#78350F;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
