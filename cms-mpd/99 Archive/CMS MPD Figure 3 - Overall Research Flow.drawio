        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Held-out Evaluation and Reviewer Outputs&lt;/font&gt;&lt;br&gt;&lt;br&gt;Scenario-held-out evaluation&lt;br&gt;Top-k agreement and NDCG&lt;br&gt;Coverage, cost, and uncovered-drug guardrails&lt;br&gt;Prescription sample retrieval&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Tables, figures, and traceable manuscript evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=3;fontSize=14;fontColor=#134E4A;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1490" y="560" width="315" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="guardrail" value="&lt;b&gt;Safety Boundary&lt;/b&gt;: machine learning never invents plan facts. It reranks only already simulated candidate rows within coverage and priceability buckets: full + priceable, partial, fallback/unpriceable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontSize=16;fontColor=#7C2D12;shadow=1;arcSize=10;spacing=10;" vertex="1" parent="1">
