        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Scenario Replay to Feature Rows&lt;/font&gt;&lt;br&gt;&lt;br&gt;Replay canonical scenarios through the same rules engine&lt;br&gt;One row per scenario-plan candidate&lt;br&gt;Cost, coverage, network, restriction, match, and missing-data features&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Runtime evidence becomes research dataset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=3;fontSize=14;fontColor=#3B0764;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1115" y="370" width="310" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Weak Labels and Model Training&lt;/font&gt;&lt;br&gt;&lt;br&gt;Coverage-first weak-label target&lt;br&gt;Student-safe feature policy&lt;br&gt;Linear ridge reranker&lt;br&gt;Shallow residual tree reranker&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Learned score over simulated evidence rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=3;fontSize=14;fontColor=#581C87;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
