        <mxCell id="p1" value="&lt;b&gt;Phase 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Study Framing and Source Provenance&lt;/font&gt;&lt;br&gt;&lt;br&gt;Public CMS plan-design files&lt;br&gt;Local reference enrichments&lt;br&gt;PDE-compatible local sample&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Boundary: public vs local vs restricted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=14;fontColor=#0F172A;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
