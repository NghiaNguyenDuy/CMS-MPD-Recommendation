        <mxCell id="p3" value="&lt;b&gt;Phase 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Runtime Recommendation and Explanation Generation&lt;/font&gt;&lt;br&gt;&lt;br&gt;Beneficiary profile + exact drugs&lt;br&gt;ZIP-eligible candidate plans&lt;br&gt;Fill-level cost simulation&lt;br&gt;Evidence and watchout traces&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Rules-first recommendation engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=3;fontSize=14;fontColor=#881337;shadow=1;arcSize=12;spacing=12;" vertex="1" parent="1">
